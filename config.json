{
  "_comment": "把 owner 改成你的 GitHub 用户名；repo 名可改；branch 固定 data（采集器每次重写该分支，仓库不会膨胀）",
  "repo": {
    "owner": "YOUR_GITHUB_NAME",
    "name": "btc-proxy",
    "branch": "data"
  },
  "symbols": ["BTCUSDT", "ETHUSDT", "SOLUSDT"],
  "spot_base": "https://api.binance.com",
  "futures_base": "https://fapi.binance.com",
  "kline_interval": "5m",
  "backfill_days": 3,
  "timeout_sec": 10,
  "retries": 3,
  "local_output": "../parquet/crypto"
}
